{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docfill",
  "version": "0.2.1",
  "identifier": "de.carvalhodasilva.docfill",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run check"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "Docfill", "width": 900, "height": 620, "minWidth": 680, "minHeight": 460, "theme": "Dark",
        "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
